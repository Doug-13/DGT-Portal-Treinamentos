+++ b/src/webparts/portalTreinamentosWebPart/pages/Orcamento/PlanejamentoOrcamentarioPage.tsx
@@ -0,0 +1,894 @@
+import * as React from 'react';
+
+import {
+  DataverseService
+} from '../../services/DataverseService';
+
+import {
+  IContextoAcesso
+} from '../../services/AutorizacaoService';
+
+import {
+  ILinhaOrcamento,
+  IPlanilhaOrcamento,
+  OrcamentoService,
+  arredondar,
+  novaChaveTemporaria,
+  mesesVazios,
+  totalLinha
+} from '../../services/orcamento/OrcamentoService';
+
+import {
+  STATUS_PLANILHA,
+  anoPadraoOrcamento
+} from '../../services/orcamento/esquemaOrcamento';
+
+import {
+  IContaOrcamento
+} from '../../services/orcamento/planoContasOrcamento';
+
+import TabelaOrcamento from './TabelaOrcamento';
+import AdicionarLinhaModal from './AdicionarLinhaModal';
+
+import {
+  COR,
+  CartaoNumero,
+  FONTE,
+  SeloStatus,
+  agruparLinhas,
+  baixarCsv,
+  botao,
+  cartao,
+  estiloAba,
+  formatarData,
+  formatarMoeda,
+  gerarCsvOrcamento,
+  nomeArquivoSeguro,
+  somar,
+  somarMeses
+} from './orcamentoComum';
+
+// ============================================================
+// PLANEJAMENTO ORÇAMENTÁRIO
+//
+// • "Minha planilha": cada gestor preenche a SUA planilha do ano
+//   (adiciona, altera e remove linhas). Ao terminar, envia; a
+//   planilha enviada fica somente leitura até o Administrador
+//   reabrir.
+// • "Todas as planilhas" (somente Administrador): lista de todas as
+//   planilhas do ano, consulta de cada uma, consolidado por grupo,
+//   exportação e reabertura.
+//
+// A rota só aparece para Gestor (global ou de área) e Administrador
+// (RoutePermissionService). A proteção dos dados está nas Security
+// Roles do Dataverse — ver scripts/dataverse/criar-tabelas-orcamento.ps1.
+// ============================================================
+
+export interface IPlanejamentoOrcamentarioPageProps {
+  dataverseService?: DataverseService;
+  contexto?: IContextoAcesso;
+}
+
+type Aba = 'minha' | 'todas';
+
+// Campos que contam como "alteração" de uma linha.
+const assinatura = (linha: ILinhaOrcamento): string =>
+  JSON.stringify([linha.descricao, linha.valores]);
+
+const mensagemErro = (erro: unknown): string =>
+  erro instanceof Error ? erro.message : String(erro);
+
+// Explica o erro mais comum (tabela ainda não criada / sem permissão).
+const explicarErro = (erro: unknown): string => {
+  const texto = mensagemErro(erro);
+  if (/dgt_orcamento/i.test(texto) && /(404|not found|does not exist|Could not find)/i.test(texto)) {
+    return 'As tabelas do Planejamento orçamentário ainda não existem no Dataverse. Execute o script scripts/dataverse/criar-tabelas-orcamento.ps1. Detalhe: ' + texto;
+  }
+  if (/(403|privilege|prvRead|prvCreate|prvWrite|prvAppend)/i.test(texto)) {
+    return 'Seu usuário não tem a permissão necessária nas tabelas do orçamento (Security Role). Fale com um administrador. Detalhe: ' + texto;
+  }
+  return texto;
+};
+
+const PlanejamentoOrcamentarioPage: React.FC<IPlanejamentoOrcamentarioPageProps> = (props) => {
+
+  const { dataverseService, contexto } = props;
+
+  const ehAdmin = !!contexto && contexto.perfil === 'Administrador';
+
+  const servico =
+    React.useMemo(
+      () => (dataverseService ? new OrcamentoService(dataverseService) : undefined),
+      [dataverseService]
+    );
+
+  const anoInicial = anoPadraoOrcamento();
+  const anosDisponiveis = [anoInicial - 1, anoInicial, anoInicial + 1];
+
+  const [aba, setAba] = React.useState<Aba>('minha');
+  const [ano, setAno] = React.useState<number>(anoInicial);
+
+  // ---------------- Minha planilha ----------------
+  const [planilha, setPlanilha] = React.useState<IPlanilhaOrcamento | undefined>(undefined);
+  const [linhas, setLinhas] = React.useState<ILinhaOrcamento[]>([]);
+  const [originais, setOriginais] = React.useState<{ [id: string]: string }>({});
+  const [removidas, setRemovidas] = React.useState<ILinhaOrcamento[]>([]);
+  const [carregando, setCarregando] = React.useState(true);
+  const [salvando, setSalvando] = React.useState(false);
+  const [erro, setErro] = React.useState('');
+  const [aviso, setAviso] = React.useState('');
+  const [modalAberto, setModalAberto] = React.useState(false);
+
+  // ---------------- Todas (Administrador) ----------------
+  const [planilhas, setPlanilhas] = React.useState<IPlanilhaOrcamento[]>([]);
+  const [linhasTodas, setLinhasTodas] = React.useState<ILinhaOrcamento[]>([]);
+  const [carregandoTodas, setCarregandoTodas] = React.useState(false);
+  const [erroTodas, setErroTodas] = React.useState('');
+  const [planilhaAbertaId, setPlanilhaAbertaId] = React.useState('');
+
+  // ----------------------------------------------------------
+  // Alterações pendentes
+  // ----------------------------------------------------------
+
+  const novas = linhas.filter(linha => !linha.id);
+
+  const alteradas =
+    linhas.filter(linha => !!linha.id && originais[linha.id] !== assinatura(linha));
+
+  const removidasGravadas = removidas.filter(linha => !!linha.id);
+
+  const totalPendencias = novas.length + alteradas.length + removidasGravadas.length;
+
+  const chavesAlteradas =
+    novas.map(linha => linha.chave).concat(alteradas.map(linha => linha.chave));
+
+  const somenteLeitura = !planilha || planilha.status === STATUS_PLANILHA.enviada;
+
+  // Aviso do navegador ao fechar/recarregar com alterações não salvas.
+  const pendenciasRef = React.useRef(0);
+  pendenciasRef.current = totalPendencias;
+
+  React.useEffect(() => {
+    const antesDeSair = (evento: BeforeUnloadEvent): string | undefined => {
+      if (pendenciasRef.current > 0) {
+        evento.preventDefault();
+        evento.returnValue = '';
+        return '';
+      }
+      return undefined;
+    };
+    window.addEventListener('beforeunload', antesDeSair);
+    return () => window.removeEventListener('beforeunload', antesDeSair);
+  }, []);
+
+  const confirmarDescarte = (): boolean =>
+    pendenciasRef.current === 0 ||
+    window.confirm('Existem alterações não salvas na sua planilha. Deseja descartá-las?');
+
+  // ----------------------------------------------------------
+  // Carregamento
+  // ----------------------------------------------------------
+
+  const aplicarLinhasCarregadas = (lista: ILinhaOrcamento[]): void => {
+    const mapa: { [id: string]: string } = {};
+    lista.forEach(linha => {
+      if (linha.id) {
+        mapa[linha.id] = assinatura(linha);
+      }
+    });
+    setLinhas(lista);
+    setOriginais(mapa);
+    setRemovidas([]);
+  };
+
+  const carregarMinha = React.useCallback(async (): Promise<void> => {
+
+    if (!servico || !contexto) {
+      setCarregando(false);
+      return;
+    }
+
+    setCarregando(true);
+    setErro('');
+    setAviso('');
+
+    try {
+      const encontrada =
+        await servico.carregarPlanilhaDoGestor(ano, contexto.usuarioId);
+
+      setPlanilha(encontrada);
+
+      aplicarLinhasCarregadas(
+        encontrada ? await servico.carregarLinhas(encontrada.id) : []
+      );
+    } catch (falha) {
+      setErro(explicarErro(falha));
+      setPlanilha(undefined);
+      aplicarLinhasCarregadas([]);
+    } finally {
+      setCarregando(false);
+    }
+  }, [servico, contexto, ano]);
+
+  const carregarTodas = React.useCallback(async (): Promise<void> => {
+
+    if (!servico || !ehAdmin) {
+      return;
+    }
+
+    setCarregandoTodas(true);
+    setErroTodas('');
+
+    try {
+      const lista = await servico.listarPlanilhas(ano);
+      setPlanilhas(lista);
+      setLinhasTodas(
+        lista.length > 0
+          ? await servico.carregarLinhasDePlanilhas(lista.map(item => item.id))
+          : []
+      );
+    } catch (falha) {
+      setErroTodas(explicarErro(falha));
+      setPlanilhas([]);
+      setLinhasTodas([]);
+    } finally {
+      setCarregandoTodas(false);
+    }
+  }, [servico, ehAdmin, ano]);
+
+  React.useEffect(() => {
+    carregarMinha().catch(() => undefined);
+  }, [carregarMinha]);
+
+  React.useEffect(() => {
+    if (aba === 'todas') {
+      carregarTodas().catch(() => undefined);
+    }
+  }, [aba, carregarTodas]);
+
+  // ----------------------------------------------------------
+  // Ações — Minha planilha
+  // ----------------------------------------------------------
+
+  const iniciarPlanilha = async (): Promise<void> => {
+    if (!servico || !contexto) {
+      return;
+    }
+    setSalvando(true);
+    setErro('');
+    try {
+      const criada = await servico.criarPlanilha(ano, contexto);
+      setPlanilha(criada);
+      aplicarLinhasCarregadas([]);
+      setAviso(`Planilha de ${ano} criada. Use "Adicionar linha" para incluir as contas.`);
+    } catch (falha) {
+      setErro(explicarErro(falha));
+    } finally {
+      setSalvando(false);
+    }
+  };
+
+  const proximaOrdem = (): number =>
+    linhas.reduce((maior, linha) => Math.max(maior, linha.ordem), 0) + 10;
+
+  const adicionarLinha = (conta: IContaOrcamento, descricao: string): void => {
+    if (!planilha) {
+      return;
+    }
+    const nova: ILinhaOrcamento = {
+      chave: novaChaveTemporaria(),
+      planilhaId: planilha.id,
+      grupo: conta.grupo,
+      codigo: conta.codigo,
+      conta: conta.conta,
+      descricao,
+      ordem: proximaOrdem(),
+      valores: mesesVazios()
+    };
+    setLinhas(atual => atual.concat([nova]));
+    setAviso('');
+  };
+
+  const alterarLinha = (
+    chave: string,
+    alterar: (linha: ILinhaOrcamento) => ILinhaOrcamento
+  ): void => {
+    setLinhas(atual => atual.map(linha => (linha.chave === chave ? alterar(linha) : linha)));
+    setAviso('');
+  };
+
+  const alterarValor = (chave: string, mes: number, valor: number): void =>
+    alterarLinha(chave, linha => {
+      const valores = linha.valores.slice();
+      valores[mes] = arredondar(valor);
+      return { ...linha, valores };
+    });
+
+  const colarValores = (chave: string, mesInicial: number, colados: number[]): void =>
+    alterarLinha(chave, linha => {
+      const valores = linha.valores.slice();
+      colados.forEach((valor, deslocamento) => {
+        const mes = mesInicial + deslocamento;
+        if (mes < 12) {
+          valores[mes] = arredondar(valor);
+        }
+      });
+      return { ...linha, valores };
+    });
+
+  const repetirJaneiro = (chave: string): void =>
+    alterarLinha(chave, linha => ({
+      ...linha,
+      valores: linha.valores.map(() => linha.valores[0])
+    }));
+
+  const alterarDescricao = (chave: string, descricao: string): void =>
+    alterarLinha(chave, linha => ({ ...linha, descricao }));
+
+  const removerLinha = (chave: string): void => {
+    const linha = linhas.filter(item => item.chave === chave)[0];
+    if (!linha) {
+      return;
+    }
+    const temValor = totalLinha(linha) !== 0;
+    if (
+      temValor &&
+      !window.confirm(`Remover a linha "${linha.codigo} ${linha.conta}"? Ela some da planilha ao salvar (o registro fica no histórico).`)
+    ) {
+      return;
+    }
+    setLinhas(atual => atual.filter(item => item.chave !== chave));
+    if (linha.id) {
+      setRemovidas(atual => atual.concat([linha]));
+    }
+    setAviso('');
+  };
+
+  const descartar = (): void => {
+    if (!confirmarDescarte()) {
+      return;
+    }
