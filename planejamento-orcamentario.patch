+// • Colar uma linha copiada do Excel (valores separados por TAB)
+//   preenche os meses a partir da célula onde colou.
+// • Em somente leitura (planilha enviada ou visão do Administrador)
+//   os campos viram texto.
+// ============================================================
+
+export interface ITabelaOrcamentoProps {
+  linhas: ILinhaOrcamento[];
+  somenteLeitura: boolean;
+  ano: number;
+  // Chaves das linhas com alteração ainda não salva (destaque).
+  chavesAlteradas?: string[];
+  onAlterarValor?: (chave: string, mes: number, valor: number) => void;
+  onColarValores?: (chave: string, mesInicial: number, valores: number[]) => void;
+  onAlterarDescricao?: (chave: string, descricao: string) => void;
+  onRepetirJaneiro?: (chave: string) => void;
+  onRemover?: (chave: string) => void;
+}
+
+const LARGURA_CONTA = 300;
+const LARGURA_MES = 104;
+const LARGURA_TOTAL = 120;
+
+const celula: React.CSSProperties = {
+  padding: '6px 8px',
+  borderBottom: `1px solid ${COR.borda}`,
+  fontSize: '13px',
+  color: COR.azul,
+  fontFamily: FONTE,
+  whiteSpace: 'nowrap'
+};
+
+const celulaNumero: React.CSSProperties = {
+  ...celula,
+  textAlign: 'right',
+  width: `${LARGURA_MES}px`,
+  minWidth: `${LARGURA_MES}px`
+};
+
+// Primeira coluna fixa ao rolar para o lado.
+const colunaFixa = (fundo: string): React.CSSProperties => ({
+  position: 'sticky',
+  left: 0,
+  zIndex: 1,
+  background: fundo,
+  width: `${LARGURA_CONTA}px`,
+  minWidth: `${LARGURA_CONTA}px`,
+  maxWidth: `${LARGURA_CONTA}px`,
+  boxShadow: `1px 0 0 ${COR.borda}`
+});
+
+// ------------------------------------------------------------
+// Campo de valor: mostra formatado; ao focar, edita o número.
+// ------------------------------------------------------------
+
+interface ICampoValorProps {
+  valor: number;
+  rotulo: string;
+  onConfirmar: (valor: number) => void;
+  onColar?: (valores: number[]) => void;
+}
+
+const CampoValor: React.FC<ICampoValorProps> = (props) => {
+
+  const [editando, setEditando] = React.useState(false);
+  const [textoCampo, setTextoCampo] = React.useState('');
+  const [invalido, setInvalido] = React.useState(false);
+
+  const confirmar = (): void => {
+    const convertido = converterValor(textoCampo);
+    if (isNaN(convertido)) {
+      setInvalido(true);
+      return;
+    }
+    setInvalido(false);
+    setEditando(false);
+    if (convertido !== props.valor) {
+      props.onConfirmar(convertido);
+    }
+  };
+
+  const aoColar = (evento: React.ClipboardEvent<HTMLInputElement>): void => {
+    if (!props.onColar) {
+      return;
+    }
+    const colado = evento.clipboardData.getData('text') || '';
+    // Só trata colagem de várias células (linha do Excel).
+    if (colado.indexOf('\t') < 0) {
+      return;
+    }
+    evento.preventDefault();
+    const valores =
+      colado
+        .replace(/\r?\n$/, '')
+        .split(/\r?\n/)[0]
+        .split('\t')
+        .map(parte => converterValor(parte));
+    if (valores.some(valor => isNaN(valor))) {
+      setInvalido(true);
+      return;
+    }
+    setEditando(false);
+    setInvalido(false);
+    props.onColar(valores);
+  };
+
+  return (
+    <input
+      type="text"
+      inputMode="decimal"
+      aria-label={props.rotulo}
+      title={invalido ? 'Valor inválido. Use, por exemplo, 1.234,56' : props.rotulo}
+      value={editando ? textoCampo : (props.valor ? formatarValor(props.valor) : '')}
+      placeholder="0,00"
+      onFocus={evento => {
+        setEditando(true);
+        setTextoCampo(props.valor ? formatarValor(props.valor) : '');
+        const alvo = evento.currentTarget;
+        window.setTimeout(() => alvo.select(), 0);
+      }}
+      onChange={evento => {
+        setTextoCampo(evento.target.value);
+        setInvalido(false);
+      }}
+      onBlur={confirmar}
+      onPaste={aoColar}
+      onKeyDown={evento => {
+        if (evento.key === 'Enter') {
+          (evento.currentTarget as HTMLInputElement).blur();
+        }
+        if (evento.key === 'Escape') {
+          setEditando(false);
+          setInvalido(false);
+        }
+      }}
+      style={{
+        width: '100%',
+        boxSizing: 'border-box',
+        padding: '6px 6px',
+        border: `1px solid ${invalido ? COR.perigo : COR.borda}`,
+        borderRadius: '5px',
+        textAlign: 'right',
+        fontSize: '13px',
+        fontFamily: FONTE,
+        color: COR.azul,
+        background: invalido ? '#FDE7E9' : '#FFFFFF'
+      }}
+    />
+  );
+};
+
+// ------------------------------------------------------------
+// Tabela
+// ------------------------------------------------------------
+
+const TabelaOrcamento: React.FC<ITabelaOrcamentoProps> = (props) => {
+
+  const grupos =
+    React.useMemo(
+      () => agruparLinhas(props.linhas),
+      [props.linhas]
+    );
+
+  const totaisGerais =
+    React.useMemo(
+      () => somarMeses(props.linhas),
+      [props.linhas]
+    );
+
+  const alteradas = props.chavesAlteradas || [];
+
+  const colunasAcoes = props.somenteLeitura ? 0 : 1;
+
+  return (
+    <div
+      style={{
+        overflowX: 'auto',
+        border: `1px solid ${COR.borda}`,
+        borderRadius: '10px',
+        background: '#FFFFFF'
+      }}
+    >
+      <table
+        style={{
+          borderCollapse: 'separate',
+          borderSpacing: 0,
+          width: '100%',
+          fontFamily: FONTE
+        }}
+      >
+        <thead>
+          <tr>
+            <th style={{ ...celula, ...colunaFixa('#F1F5F9'), textAlign: 'left', fontWeight: 700, zIndex: 2 }}>
+              Conta
+            </th>
+            {NOMES_MESES.map(mes => (
+              <th key={mes} style={{ ...celulaNumero, background: '#F1F5F9', fontWeight: 700 }}>
+                {mes}/{String(props.ano).substring(2)}
+              </th>
+            ))}
+            <th style={{ ...celulaNumero, background: '#F1F5F9', fontWeight: 700, width: `${LARGURA_TOTAL}px`, minWidth: `${LARGURA_TOTAL}px` }}>
+              Total
+            </th>
+            {colunasAcoes > 0 && (
+              <th style={{ ...celula, background: '#F1F5F9', width: '76px' }} />
+            )}
+          </tr>
+        </thead>
+
+        <tbody>
+          {grupos.map(grupo => (
+            <React.Fragment key={grupo.grupo}>
+
+              {/* Subtotal do grupo */}
+              <tr>
+                <td style={{ ...celula, ...colunaFixa(COR.fundoGrupo), fontWeight: 700 }}>
+                  {grupo.grupo}
+                </td>
+                {grupo.totais.map((valor, indice) => (
+                  <td key={indice} style={{ ...celulaNumero, background: COR.fundoGrupo, fontWeight: 700 }}>
+                    {formatarValor(valor)}
+                  </td>
+                ))}
+                <td style={{ ...celulaNumero, background: COR.fundoGrupo, fontWeight: 700 }}>
+                  {formatarValor(grupo.total)}
+                </td>
+                {colunasAcoes > 0 && (
+                  <td style={{ ...celula, background: COR.fundoGrupo }} />
+                )}
+              </tr>
+
+              {grupo.linhas.map(linha => {
+
+                const alterada = alteradas.indexOf(linha.chave) >= 0;
+                const fundo = alterada ? COR.alterado : '#FFFFFF';
+
+                return (
+                  <tr key={linha.chave}>
+
+                    <td style={{ ...celula, ...colunaFixa(fundo), whiteSpace: 'normal' }}>
+                      <div style={{ fontSize: '11.5px', color: COR.texto2 }}>
+                        {linha.codigo}
+                        {alterada && (
+                          <span style={{ marginLeft: '6px', color: '#B45309', fontWeight: 700 }}>
+                            • não salvo
+                          </span>
+                        )}
+                      </div>
+                      <div style={{ fontWeight: 600, lineHeight: 1.25 }}>
+                        {linha.conta}
+                      </div>
+                      {props.somenteLeitura ? (
+                        linha.descricao && (
+                          <div style={{ fontSize: '12px', color: COR.texto2, marginTop: '2px' }}>
+                            {linha.descricao}
+                          </div>
+                        )
+                      ) : (
+                        <input
+                          type="text"
+                          value={linha.descricao}
+                          maxLength={400}
+                          placeholder="Descrição / justificativa (opcional)"
+                          aria-label={`Descrição de ${linha.conta}`}
+                          onChange={evento =>
+                            props.onAlterarDescricao &&
+                            props.onAlterarDescricao(linha.chave, evento.target.value)
+                          }
+                          style={{
+                            width: '100%',
+                            boxSizing: 'border-box',
+                            marginTop: '4px',
+                            padding: '4px 6px',
+                            border: `1px solid ${COR.borda}`,
+                            borderRadius: '5px',
+                            fontSize: '12px',
+                            fontFamily: FONTE,
+                            color: COR.azul,
+                            background: '#FFFFFF'
+                          }}
+                        />
+                      )}
+                    </td>
+
+                    {linha.valores.map((valor, mes) => (
+                      <td key={mes} style={{ ...celulaNumero, background: fundo, padding: props.somenteLeitura ? celula.padding : '4px' }}>
+                        {props.somenteLeitura ? (
+                          valor ? formatarValor(valor) : <span style={{ color: '#CBD5E1' }}>0,00</span>
+                        ) : (
+                          <CampoValor
+                            valor={valor}
+                            rotulo={`${linha.conta} — ${NOMES_MESES[mes]}/${props.ano}`}
+                            onConfirmar={novo =>
+                              props.onAlterarValor &&
+                              props.onAlterarValor(linha.chave, mes, novo)
+                            }
+                            onColar={valores =>
+                              props.onColarValores &&
+                              props.onColarValores(linha.chave, mes, valores)
+                            }
+                          />
+                        )}
+                      </td>
+                    ))}
+
+                    <td style={{ ...celulaNumero, background: fundo, fontWeight: 700, width: `${LARGURA_TOTAL}px`, minWidth: `${LARGURA_TOTAL}px` }}>
+                      {formatarValor(totalLinha(linha))}
+                    </td>
+
+                    {colunasAcoes > 0 && (
+                      <td style={{ ...celula, background: fundo, textAlign: 'center' }}>
+                        <div style={{ display: 'flex', gap: '4px', justifyContent: 'center' }}>
+                          <button
+                            type="button"
+                            title="Repetir o valor de janeiro em todos os meses"
+                            aria-label={`Repetir janeiro em todos os meses de ${linha.conta}`}
+                            onClick={() => props.onRepetirJaneiro && props.onRepetirJaneiro(linha.chave)}
+                            style={{ border: `1px solid ${COR.borda}`, background: '#FFFFFF', borderRadius: '5px', cursor: 'pointer', padding: '3px 6px', fontSize: '12px', color: COR.azul }}
+                          >
+                            ⇉
+                          </button>
+                          <button
+                            type="button"
+                            title="Remover esta linha"
+                            aria-label={`Remover ${linha.conta}`}
+                            onClick={() => props.onRemover && props.onRemover(linha.chave)}
+                            style={{ border: `1px solid #F3C1C1`, background: '#FFFFFF', borderRadius: '5px', cursor: 'pointer', padding: '3px 7px', fontSize: '12px', color: COR.perigo }}
+                          >
+                            ✕
+                          </button>
+                        </div>
+                      </td>
+                    )}
+                  </tr>
+                );
+              })}
+            </React.Fragment>
+          ))}
+        </tbody>
+
+        <tfoot>
+          <tr>
+            <td style={{ ...celula, ...colunaFixa(COR.azul), color: '#FFFFFF', fontWeight: 700, borderBottom: 0 }}>
+              TOTAL GERAL
+            </td>
+            {totaisGerais.map((valor, indice) => (
+              <td key={indice} style={{ ...celulaNumero, background: COR.azul, color: '#FFFFFF', fontWeight: 700, borderBottom: 0 }}>
+                {formatarValor(valor)}
+              </td>
+            ))}
+            <td style={{ ...celulaNumero, background: COR.azul, color: '#FFFFFF', fontWeight: 700, borderBottom: 0 }}>
+              {formatarValor(somar(totaisGerais))}
+            </td>
+            {colunasAcoes > 0 && (
+              <td style={{ ...celula, background: COR.azul, borderBottom: 0 }} />
+            )}
+          </tr>
+        </tfoot>
+      </table>
+    </div>
+  );
+};
+
+export default TabelaOrcamento;
