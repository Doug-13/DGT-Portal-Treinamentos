                        style={{
                          width:
                            '190px',

                          height:
                            '105px',

                          objectFit:
                            'cover',

                          borderRadius:
                            '10px',

                          background:
                            '#EAF0F5'
                        }}
                      />

                      <div>
                        <span
                          style={{
                            display:
                              'inline-block',

                            padding:
                              '4px 8px',

                            borderRadius:
                              '999px',

                            background:
                              '#E8F3FF',

                            color:
                              '#0B6FD6',

                            fontSize:
                              '11px',

                            fontWeight:
                              800
                          }}
                        >
                          EM ANDAMENTO
                        </span>

                        <h3
                          style={{
                            margin:
                              '6px 0 4px',

                            color:
                              '#0B2D4D',

                            fontSize:
                              '18px'
                          }}
                        >
                          {
                            continuar.nome
                          }
                        </h3>

                        <div
                          style={{
                            color:
                              '#5C7287',

                            fontSize:
                              '13px'
                          }}
                        >
                          {
                            continuar.codigo
                          } | Carga horária: {
                            continuar.cargaHoraria
                          }
                        </div>

                        <div
                          style={{
                            display:
                              'grid',

                            gridTemplateColumns:
                              '1fr 44px',

                            alignItems:
                              'center',

                            gap:
                              '10px',

                            marginTop:
                              '12px'
                          }}
                        >
                          <div
                            style={{
                              height:
                                '10px',

                              borderRadius:
                                '999px',

                              overflow:
                                'hidden',

                              background:
                                '#E3E9EE'
                            }}
                          >
                            <div
                              style={{
                                height:
                                  '100%',

                                width:
                                  `${clamp(
                                    continuar.progresso
                                  )}%`,

                                borderRadius:
                                  '999px',

                                background:
                                  '#1683E7'
                              }}
                            />
                          </div>

                          <strong
                            style={{
                              color:
                                '#0B2D4D'
                            }}
                          >
                            {
                              clamp(
                                continuar.progresso
                              )
                            }%
                          </strong>
                        </div>
                      </div>

                      <button
                        type="button"
                        onClick={() =>
                          props.onAbrirTreinamento(
                            continuar
                          )
                        }
                        style={{
                          padding:
                            '11px 14px',

                          border:
                            0,

                          borderRadius:
                            '8px',

                          background:
                            '#073A67',

                          color:
                            '#FFFFFF',

                          cursor:
                            'pointer',

                          fontWeight:
                            700
                        }}
                      >
                        Continuar →
                      </button>
                    </div>
                  )
                  : (
                    <div
                      style={{
                        padding:
                          '18px'
                      }}
                    >
                      <EmptyState
                        titulo="Nenhum treinamento em andamento"
                      />
                    </div>
                  )
              }
            </article>

            {/* MEUS TREINAMENTOS */}

            <article
              style={{
                ...CARD,

                padding:
                  '15px'
              }}
            >
              <div
                style={{
                  display:
                    'flex',

                  justifyContent:
                    'space-between',

                  alignItems:
                    'center'
                }}
              >
                <strong>
                  🎓 Meus treinamentos
                </strong>

                <button
                  type="button"
                  onClick={
                    props.onVerTreinamentos
                  }
                  style={
                    BOTAO_LINK
                  }
                >
                  Ver todos →
                </button>
              </div>

              {
                meusTreinamentos.length ===
                  0
                  ? (
                    <div
                      style={{
                        marginTop:
                          '14px'
                      }}
                    >
                      <EmptyState
                        titulo="Nenhum treinamento atribuído"
                      />
                    </div>
                  )
                  : (
                    <div
                      style={{
                        display:
                          'grid',

                        gridTemplateColumns:
                          'repeat(4,minmax(0,1fr))',

                        gap:
                          '12px',

                        marginTop:
                          '13px'
                      }}
                    >
                      {
                        meusTreinamentos.map(
                          item => (
                            <TreinamentoCard
                              key={
                                `${item.id}-${item.usuarioTreinamentoId || ''}`
                              }
                              treinamento={
                                item
                              }
                              modo="compacto"
                              onAbrir={
                                props.onAbrirTreinamento
                              }
                            />
                          )
                        )
                      }
                    </div>
                  )
              }
            </article>

            {/* TRILHAS RECOMENDADAS */}

            <article
              style={{
                ...CARD,

                padding:
                  '15px'
              }}
            >
              <div
                style={{
                  display:
                    'flex',

                  justifyContent:
                    'space-between',

                  alignItems:
                    'center'
                }}
              >
                <strong>
                  ☆ Trilhas recomendadas para você
                </strong>

                {
                  props.onVerTrilhas &&
                  (
                    <button
                      type="button"
                      onClick={
                        props.onVerTrilhas
                      }
                      style={
                        BOTAO_LINK
                      }
                    >
                      Ver trilhas →
                    </button>
                  )
                }
              </div>

              <div
                style={{
                  display:
                    'grid',

                  gridTemplateColumns:
                    'repeat(4,minmax(0,1fr))',

                  gap:
                    '10px',

                  marginTop:
                    '12px'
                }}
              >
                {
                  (
                    trilhas.length >
                      0
                      ? trilhas.slice(
                        0,
                        4
                      )
                      : [
                        {
                          id:
                            'lideranca',

                          nome:
                            'Liderança DGT',

                          descricao:
                            'Desenvolvimento de líderes'
                        },
                        {
                          id:
                            'meio-ambiente',

                          nome:
                            'Meio Ambiente',

                          descricao:
                            'Sustentabilidade e boas práticas'
                        },
                        {
                          id:
                            'qualidade',

                          nome:
                            'Gestão da Qualidade',

                          descricao:
                            'Processos e melhoria contínua'
                        },
                        {
                          id:
                            'compliance',

                          nome:
                            'Compliance',

                          descricao:
                            'Ética e conformidade'
                        }
                      ]
                  ).map(
                    (
                      item:
                        ITrilha |
                        {
                          id:
                            string;

                          nome:
                            string;

                          descricao:
                            string;
                        }
                    ) => (
                      <div
                        key={
                          item.id
                        }
                        style={{
                          padding:
                            '12px',

                          border:
                            '1px solid #E6ECF1',

                          borderRadius:
                            '10px',

                          background:
                            '#FAFCFE'
                        }}
                      >
                        <strong
                          style={{
                            display:
                              'block',

                            color:
                              '#173B5D'
                          }}
                        >
                          {
                            item.nome
                          }
                        </strong>

                        <small
                          style={{
                            display:
                              'block',

                            marginTop:
                              '4px',

                            color:
                              '#64748B'
                          }}
                        >
                          {
                            item.descricao
                          }
                        </small>
                      </div>
                    )
                  )
                }
              </div>
            </article>

          </div>

          {/* LATERAL */}

          <aside
            style={{
              display:
                'grid',

              gap:
                '16px'
            }}
          >

            <article
              style={{
                ...CARD,

                padding:
                  '15px'
              }}
            >
              <div
                style={{
                  display:
                    'flex',

                  justifyContent:
                    'space-between',

                  alignItems:
                    'center'
                }}
              >
                <strong>
                  🗓 Próximos treinamentos
                </strong>

                <button
                  type="button"
                  onClick={
                    props.onVerTreinamentos
                  }
                  style={
                    BOTAO_LINK
                  }
                >
                  Ver todos →
                </button>
              </div>

              {
                proximos.length ===
                  0
                  ? (
                    <div
                      style={{
                        marginTop:
                          '12px',

                        color:
                          '#64748B',

                        fontSize:
                          '13px'
                      }}
                    >
                      Nenhum treinamento disponível no momento.
                    </div>
                  )
                  : proximos.map(
                    (
                      item,
                      indice
                    ) => (
                      <button
                        key={
                          item.id
                        }
                        type="button"
                        onClick={() =>
                          props.onAbrirTreinamento(
                            item
                          )
                        }
                        style={{
                          width:
                            '100%',

                          display:
                            'grid',

                          gridTemplateColumns:
                            '52px 1fr',

                          gap:
                            '10px',

                          padding:
                            '11px 0',

                          border:
                            0,

                          borderBottom:
                            '1px solid #EDF1F5',

                          background:
                            'transparent',

                          textAlign:
                            'left',

                          cursor:
                            'pointer'
                        }}
                      >
                        <div
                          style={{
                            padding:
                              '8px 5px',

                            borderRadius:
                              '8px',

                            background:
                              '#EFF7F7',

                            textAlign:
                              'center',

                            color:
                              '#0B2D4D'
                          }}
                        >
                          <strong
                            style={{
                              display:
                                'block',

                              fontSize:
                                '17px'
                            }}
                          >
                            {
                              String(
                                15 +
                                (
                                  indice *
                                  5
                                )
                              )
                                .padStart(
                                  2,
                                  '0'
                                )
                            }
                          </strong>

                          <small>
                            SET
                          </small>
                        </div>

                        <div>
                          <strong
                            style={{
                              display:
                                'block',

                              color:
                                '#173B5D',

                              fontSize:
                                '13px'
                            }}
                          >
                            {
                              item.nome
                            }
                          </strong>

                          <small
                            style={{
                              display:
                                'block',

                              marginTop:
                                '5px',

                              color:
                                '#64748B'
                            }}
                          >
                            {
                              item.cargaHoraria
                            } · disponível
                          </small>
                        </div>
