import * as React from 'react';

import {
  ITreinamento
} from '../../models/Treinamento';

import {
  ITrilha
} from '../../models/Trilha';

import Loading from
  '../../components/common/Loading';

import EmptyState from
  '../../components/common/EmptyState';

import ErrorMessage from
  '../../components/common/ErrorMessage';

import TreinamentoCard from
  '../../components/treinamentos/TreinamentoCard';

export interface IVisaoGeralTreinamentosPageProps {

  primeiroNome?:
    string;

  treinamentos:
    ITreinamento[];

  trilhas?:
    ITrilha[];

  carregando:
    boolean;

  erro:
    string;

  quantidadeTrilhas:
    number;

  onAbrirTreinamento:
    (
      treinamento:
        ITreinamento
    ) => void;

  onVerTreinamentos:
    () => void;

  onVerTrilhas?:
    () => void;

  onVerCertificados?:
    () => void;

  onVerGestao?:
    () => void;
}

const CARD:
  React.CSSProperties = {

  background:
    '#FFFFFF',

  border:
    '1px solid #E3EAF1',

  borderRadius:
    '14px',

  boxShadow:
    '0 2px 8px rgba(15, 35, 55, .04)'
};

const BOTAO_LINK:
  React.CSSProperties = {

  border:
    0,

  background:
    'transparent',

  color:
    '#0867D7',

  cursor:
    'pointer',

  fontWeight:
    700,

  padding:
    0
};

const clamp =
  (
    valor:
      number
  ): number =>
    Math.max(
      0,
      Math.min(
        100,
        Number.isFinite(
          valor
        )
          ? valor
          : 0
      )
    );

const VisaoGeralTreinamentosPage:
  React.FC<
    IVisaoGeralTreinamentosPageProps
  > = (
    props
  ) => {

    const concluidos =
      props.treinamentos
        .filter(
          item =>
            item.status ===
            'Concluído'
        );

    const emAndamento =
      props.treinamentos
        .filter(
          item =>
            item.status ===
            'Em andamento'
        );

    const pendentes =
      props.treinamentos
        .filter(
          item =>
            item.status ===
            'Disponível' ||
            item.status ===
            'Reprovado'
        );

    const vencidos =
      props.treinamentos
        .filter(
          item =>
            item.status ===
            'Vencido'
        );

    const continuar =
      emAndamento[
        0
      ];

    const meusTreinamentos =
      props.treinamentos
        .slice(
          0,
          4
        );

    const trilhas =
      (
        props.trilhas ||
        []
      )
        .filter(
          item =>
            item.ativa
        )
        .slice(
          0,
          3
        );

    const proximos =
      props.treinamentos
        .filter(
          item =>
            item.status ===
            'Disponível'
        )
        .slice(
          0,
          3
        );

    const dataHoje =
      new Date()
        .toLocaleDateString(
          'pt-BR',
          {
            day:
              '2-digit',

            month:
              'long',

            year:
              'numeric'
          }
        );

    const nome =
      (
        props.primeiroNome ||
        ''
      )
        .trim();

    const resumo = [
      {
        titulo:
          'Concluídos',

        valor:
          concluidos.length,

        icone:
          '🎓',

        fundo:
          '#E8F8F1',

        detalhe:
          ''
      },
      {
        titulo:
          'Em andamento',

        valor:
          emAndamento.length,

        icone:
          '▶',

        fundo:
          '#FFF3DE',

        detalhe:
          ''
      },
      {
        titulo:
          'Pendentes',

        valor:
          pendentes.length,

        icone:
          '◷',

        fundo:
          '#FFE9EE',

        detalhe:
          'prazo próximo'
      },
      {
        titulo:
          'Vencido',

        valor:
          vencidos.length,

        icone:
          '▣',

        fundo:
          '#EAF4FF',

        detalhe:
          'requer atenção'
      },
      {
        titulo:
          'Trilhas',

        valor:
          props.quantidadeTrilhas,

        icone:
          '▰',

        fundo:
          '#F0ECFF',

        detalhe:
          'inscritas'
      }
    ];

    if (
      props.carregando
    ) {

      return (
        <Loading
          mensagem="Carregando treinamentos..."
        />
      );
    }

    return (
      <section>

        {
          props.erro &&
          (
            <div
              style={{
                marginBottom:
                  '16px'
              }}
            >
              <ErrorMessage
                mensagem={
                  props.erro
                }
              />
            </div>
          )
        }

        {/* CABEÇALHO DA VISÃO GERAL */}

        <div
          style={{
            display:
              'flex',

            alignItems:
              'flex-end',

            justifyContent:
              'space-between',

            gap:
              '20px',

            flexWrap:
              'wrap'
          }}
        >
          <div>
            <h1
              style={{
                margin:
                  0,

                color:
                  '#0A2845',

                fontSize:
                  '29px',

                lineHeight:
                  1.15
              }}
            >
              Olá{
                nome
                  ? `, ${nome}`
                  : ''
              }! 👋
            </h1>

            <p
              style={{
                margin:
                  '4px 0 0',

                color:
                  '#5C7287',

                fontSize:
                  '14px'
              }}
            >
              Aqui está um resumo da sua jornada de aprendizado.
            </p>
          </div>

          <div
            style={{
              color:
                '#64748B',

              fontSize:
                '13px'
            }}
          >
            Data de hoje: {
              dataHoje
            }
          </div>
        </div>

        {/* INDICADORES */}

        <div
          style={{
            display:
              'grid',

            gridTemplateColumns:
              'repeat(5,minmax(150px,1fr))',

            gap:
              '14px',

            marginTop:
              '16px'
          }}
        >
          {
            resumo.map(
              item => (
                <div
                  key={
                    item.titulo
                  }
                  style={{
                    minHeight:
                      '92px',

                    display:
                      'grid',

                    gridTemplateColumns:
                      '54px 1fr',

                    alignItems:
                      'center',

                    gap:
                      '12px',

                    padding:
                      '14px',

                    borderRadius:
                      '12px',

                    background:
                      item.fundo,

                    border:
                      '1px solid rgba(15,35,55,.04)'
                  }}
                >
                  <div
                    style={{
                      width:
                        '48px',

                      height:
                        '48px',

                      display:
                        'flex',

                      alignItems:
                        'center',

                      justifyContent:
                        'center',

                      borderRadius:
                        '10px',

                      background:
                        'rgba(255,255,255,.62)',

                      fontSize:
                        '24px'
                    }}
                  >
                    {
                      item.icone
                    }
                  </div>

                  <div>
                    <strong
                      style={{
                        display:
                          'block',

                        fontSize:
                          '27px',

                        color:
                          '#0B2D4D',

                        lineHeight:
                          1
                      }}
                    >
                      {
                        item.valor
                      }
                    </strong>

                    <span
                      style={{
                        display:
                          'block',

                        marginTop:
                          '5px',

                        color:
                          '#173B5D',

                        fontSize:
                          '13px'
                      }}
                    >
                      {
                        item.titulo
                      }
                    </span>

                    {
                      item.detalhe &&
                      (
                        <small
                          style={{
                            color:
                              '#5C7287'
                          }}
                        >
                          ({
                            item.detalhe
                          })
                        </small>
                      )
                    }
                  </div>
                </div>
              )
            )
          }
        </div>

        {/* CONTEÚDO PRINCIPAL */}

        <div
          style={{
            display:
              'grid',

            gridTemplateColumns:
              'minmax(0,2.1fr) minmax(280px,.9fr)',

            gap:
              '16px',

            marginTop:
              '16px',

            alignItems:
              'start'
          }}
        >

          <div
            style={{
              display:
                'grid',

              gap:
                '16px'
            }}
          >

            {/* CONTINUAR */}

            <article
              style={{
                ...CARD,

                overflow:
                  'hidden'
              }}
            >
              <div
                style={{
                  display:
                    'flex',

                  alignItems:
                    'center',

                  justifyContent:
                    'space-between',

                  padding:
                    '13px 16px',

                  borderBottom:
                    '1px solid #E8EEF4'
