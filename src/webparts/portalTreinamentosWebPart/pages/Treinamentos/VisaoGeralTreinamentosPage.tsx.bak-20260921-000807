                  display:
                    'flex',

                  justifyContent:
                    'space-between',

                  alignItems:
                    'center'
                }}
              >
                <strong>
                  ⚙ Trilhas em andamento
                </strong>

                {
                  props.onVerTrilhas &&
                  (
                    <button
                      type="button"
                      onClick={
                        props.onVerTrilhas
                      }
                      style={
                        BOTAO_LINK
                      }
                    >
                      Ver todas →
                    </button>
                  )
                }
              </div>

              {
                trilhas.length ===
                  0
                  ? (
                    <div
                      style={{
                        marginTop:
                          '12px',

                        color:
                          '#64748B',

                        fontSize:
                          '13px'
                      }}
                    >
                      Nenhuma trilha em andamento.
                    </div>
                  )
                  : trilhas.map(
                    item => (
                      <div
                        key={
                          item.id
                        }
                        style={{
                          marginTop:
                            '14px'
                        }}
                      >
                        <div
                          style={{
                            display:
                              'flex',

                            justifyContent:
                              'space-between',

                            gap:
                              '10px',

                            fontSize:
                              '12px'
                          }}
                        >
                          <strong>
                            {
                              item.nome
                            }
                          </strong>

                          <strong>
                            {
                              clamp(
                                item.progresso
                              )
                            }%
