<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes das regras PURAS da tarefa de licitação no ClickUp.
    Compila só os arquivos sem dependência do Dataverse (link de código),
    então roda em net8 sem o SDK do CRM:  dotnet test
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\DGT.Treinamentos.Plugins\PrazosLicitacao.cs" Link="Regras\PrazosLicitacao.cs" />
    <Compile Include="..\DGT.Treinamentos.Plugins\TarefaLicitacaoClickUp.cs" Link="Regras\TarefaLicitacaoClickUp.cs" />
    <Compile Include="..\DGT.Treinamentos.Plugins\DocumentosRecebidosFornecedor.cs" Link="Regras\DocumentosRecebidosFornecedor.cs" />
    <Compile Include="..\DGT.Treinamentos.Plugins\HomologacaoFornecedor.cs" Link="Regras\HomologacaoFornecedor.cs" />
    <Compile Include="..\DGT.Treinamentos.Plugins\PrecosCigam.cs" Link="Regras\PrecosCigam.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
