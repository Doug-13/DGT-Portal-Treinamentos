+
+export const servidorPadrao = (): IServidorSelecao => ({ reservaPct: RESERVA_PADRAO });
+
+// ------------------------------------------------------------
+// Análise
+// ------------------------------------------------------------
+
+export interface IOpcaoFaixa {
+  capacidade: number;
+  linhas: ILinhaServidor[];
